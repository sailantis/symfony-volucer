{
    "name": "sailantis/symfony-volucer",
    "description": "Run a Symfony application on volucer's persistent worker protocol: kernel reboot per request, no upstream changes.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "sailantis/volucer-worker": "dev-main",
        "symfony/config": "^7.1",
        "symfony/dependency-injection": "^7.1",
        "symfony/http-foundation": "^7.1",
        "symfony/http-kernel": "^7.1",
        "symfony/routing": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../volucer-php-sdk"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Sailantis\\SymfonyVolucer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sailantis\\SymfonyVolucer\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/TestKernel.php",
            "tests/EchoHandler.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
